# Copy to .env. Never paste secrets into chat or commit .env.
# Either key variable works; the prefixed key takes precedence if present.
OPENAI_API_KEY=
PERSONAL_AGENT_MODEL=gpt-4.1-mini
PERSONAL_AGENT_API_TOKEN=
PERSONAL_AGENT_OWNER_ID=personal
PERSONAL_AGENT_ENVIRONMENT=development
PERSONAL_AGENT_TIMEZONE=America/New_York
PERSONAL_AGENT_DATA_DIR=.data
# Leave blank for SQLite. Use postgresql://user:password@host:5432/database when hosted.
PERSONAL_AGENT_DATABASE_URL=
PERSONAL_AGENT_MAX_TOOL_ROUNDS=8
PERSONAL_AGENT_MODEL_TIMEOUT_SECONDS=60
PERSONAL_AGENT_CHAT_TIMEOUT_SECONDS=180
PERSONAL_AGENT_TOOL_TIMEOUT_SECONDS=30
PERSONAL_AGENT_MAX_OUTPUT_TOKENS=2048
PERSONAL_AGENT_MAX_HISTORY_CHARS=120000
PERSONAL_AGENT_LOG_LEVEL=INFO
# Future integrations; unused by the current conversation runtime.
PERSONAL_AGENT_PHOTON_PROJECT_ID=
PERSONAL_AGENT_PHOTON_API_KEY=
PERSONAL_AGENT_PHOTON_WEBHOOK_SECRET=
PERSONAL_AGENT_ALLOWED_SENDER_ID=
PERSONAL_AGENT_ALPACA_API_KEY=
PERSONAL_AGENT_ALPACA_SECRET_KEY=
