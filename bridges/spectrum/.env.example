# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Python agent connection. Use the same API token as the Python app.
PERSONAL_AGENT_API_URL=http://127.0.0.1:8000
PERSONAL_AGENT_API_TOKEN=
# Your iMessage sending address, e.g. +15551234567 or your Apple Account email.
PERSONAL_AGENT_ALLOWED_SENDER_ID=
# Typing is independent of the API's progress-message settings.
PERSONAL_AGENT_TYPING_ENABLED=true

# Send one daily motivational message to the allowed sender at 8 a.m.
PERSONAL_AGENT_MORNING_ENABLED=false
# Poll the API for the separate IBKR morning briefing; no message until IBKR is configured.
PERSONAL_AGENT_PORTFOLIO_MORNING_ENABLED=true
