# Copy to .env and generate a token with: openssl rand -hex 32
COGNEE_SERVICE_TOKEN=
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# INFO/DEBUG can include source query text in upstream Cognee logs.
LOG_LEVEL=WARNING
TELEMETRY_DISABLED=true
COGNEE_TRACING_ENABLED=false
